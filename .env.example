# Copy to .env and fill in. docker compose reads this file automatically.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DB_PASSWORD=lddiag
# Browser origins allowed to call the API (the React app)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: archive generated PDF reports to S3
AWS_REGION=ap-south-1
AWS_S3_REPORTS_BUCKET=

# Used on the EC2 server only (set by the Jenkins deploy)
# IMAGE=<account-id>.dkr.ecr.ap-south-1.amazonaws.com/ld-detection:latest
# WEB_PORT=80
